# Groww Cloud API keys page -> "Generate API key" -> TOTP token
GROWW_API_KEY=eyJ...your_totp_token...
# The base32 secret shown alongside the QR code
GROWW_TOTP_SECRET=ABCDEF123456

# Alerts. Telegram is the primary channel; Gmail is the backup.
# Telegram: @BotFather -> /newbot -> token. Then send your bot any message; the chat id comes from that.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gmail: Google account -> Security -> App passwords (needs 2-step verification). Never the normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
